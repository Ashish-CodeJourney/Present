{
  "manifest_version": 3,
  "name": "Present",
  "version": "0.1.0",
  "description": "A precision cognitive firewall by Hello Human. Removes algorithmic short-video surfaces, keeps search, subscriptions and DMs.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*.run.app/*"],
  "action": {
    "default_title": "Present",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
